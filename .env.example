DATABASE_URL=postgresql+psycopg://brandguard:change-me@localhost:5432/brandguard
POSTGRES_PASSWORD=
# Use development locally, demo for a no-ClamAV hosted demo, or production with required security services.
ENVIRONMENT=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000
JWT_SECRET_KEY=replace-with-a-long-random-secret
CHROMA_PERSIST_DIRECTORY=./chroma_db
UPLOAD_DIRECTORY=./uploads
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=60
SQLALCHEMY_ECHO=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# Frontend settings (copy these into frontend/.env.local for Vite development).
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_TIMEOUT_MS=15000
VITE_AI_REQUEST_TIMEOUT_MS=130000
