# Local development: leave VITE_API_BASE_URL empty to use the Vite /api proxy.
# Set VITE_API_PROXY_TARGET if the backend is not listening on localhost:8000.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8000

# Normal requests use this timeout; Gemini-backed analysis/suggestions use the
# longer AI-specific timeout. Both values are milliseconds.
VITE_API_TIMEOUT_MS=15000
VITE_AI_REQUEST_TIMEOUT_MS=240000

# Production (set in the Vercel project environment, not this local file):
# VITE_API_BASE_URL=https://your-backend.example.com
